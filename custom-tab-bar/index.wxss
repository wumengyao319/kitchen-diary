.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
  opacity: 0.5;
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
}

.tab-bar-item.active .tab-text {
  color: #ff6b6b;
}