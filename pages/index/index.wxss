.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.banner-section {
  padding: 24rpx;
}

.banner-swiper {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-card {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-1 {
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
}

.banner-2 {
  background: linear-gradient(135deg, #55efc4, #4d96ff);
}

.banner-3 {
  background: linear-gradient(135deg, #ff9ff3, #ffa502);
}

.banner-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.banner-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #ff6b6b;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recipe-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
}

.recipe-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.recipe-emoji {
  font-size: 56rpx;
}

.recipe-content {
  flex: 1;
  padding-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.recipe-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-tag {
  font-size: 20rpx;
  color: #ff6b6b;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: space-between;
}

.category-item {
  width: calc(25% - 9rpx);
  max-width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background: #fff;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.category-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-size: 22rpx;
  color: #666;
}

.lucky-section {
  background: linear-gradient(135deg, #ffd93d, #fdcb6e);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.lucky-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.lucky-info {
  flex: 1;
}

.lucky-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.lucky-desc {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.6);
}

.lucky-arrow {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.3);
}
.recipe-img { width: 100%; height: 100%; border-radius: inherit; }
