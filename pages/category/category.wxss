page {
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: bold;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.content-wrapper {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.category-sidebar {
  width: 180rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border-left: 6rpx solid transparent;
  transition: all 0.3s;
}

.sidebar-item.active {
  background-color: #fff5f5;
  border-left-color: #ff6b6b;
}

.sidebar-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.sidebar-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  font-weight: 500;
}

.sidebar-item.active .sidebar-name {
  color: #ff6b6b;
  font-weight: bold;
}

.recipe-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
}

.content-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.content-count {
  font-size: 26rpx;
  color: #999;
}

.recipe-scroll {
  flex: 1;
  padding: 16rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recipe-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.recipe-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.recipe-emoji {
  font-size: 56rpx;
}

.recipe-info {
  flex: 1;
  padding: 0 20rpx;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.recipe-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.recipe-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background-color: #f8f8f8;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.meta-item.difficulty {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-item.easy {
  background-color: #e8f5e9;
  color: #4caf50;
}

.meta-item.medium {
  background-color: #fff3e0;
  color: #ff9800;
}

.meta-item.hard {
  background-color: #ffebee;
  color: #f44336;
}

.recipe-actions {
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 36rpx;
  color: #ccc;
}