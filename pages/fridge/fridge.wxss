/* pages/fridge/fridge.wxss - 冰箱食材匹配 */
.scroll-page { min-height: 100vh; background: #fff7f2; box-sizing: border-box; }
.page-inner { padding: 24rpx; }

/* 厨房手账 */
.journal-card {
  background: #fff;
  border: 2rpx solid #f5e0d4;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.journal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.journal-title { font-size: 30rpx; font-weight: bold; color: #2a2825; }
.journal-sub { font-size: 22rpx; color: #999; }
.stove-line { font-size: 26rpx; color: #b3591f; margin-bottom: 12rpx; }
.stove-line.muted { color: #999; }
.stove-num { font-size: 40rpx; font-weight: 800; color: #ff6b6b; }
.cuisine-item { display: flex; align-items: center; margin-bottom: 8rpx; font-size: 22rpx; color: #666; }
.cuisine-name { width: 110rpx; flex: none; }
.cuisine-bar { flex: 1; height: 14rpx; background: #f7ede5; border-radius: 999rpx; overflow: hidden; margin: 0 12rpx; }
.cuisine-fill { height: 100%; background: linear-gradient(90deg, #ffb86b, #ff6b6b); border-radius: 999rpx; }
.cuisine-count { width: 80rpx; text-align: right; }
.journal-tip { font-size: 20rpx; color: #bbb; margin-top: 10rpx; }

/* 冰箱食材 */
.fridge-card {
  background: #fff;
  border: 2rpx solid #f5e0d4;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.fridge-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.fridge-title { font-size: 30rpx; font-weight: bold; color: #2a2825; }
.fridge-clear { font-size: 24rpx; color: #999; }
.fridge-tip { font-size: 22rpx; color: #999; margin-bottom: 18rpx; }
.ing-group { margin-bottom: 18rpx; }
.ing-group-name { font-size: 24rpx; color: #b3591f; font-weight: 600; margin-bottom: 10rpx; }
.ing-items { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ing-chip {
  font-size: 24rpx;
  color: #555;
  background: #faf3ec;
  border: 2rpx solid #f0e0d2;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  transition: all 0.15s ease;
}
.ing-chip.on {
  color: #fff;
  background: #ff6b6b;
  border-color: #ff6b6b;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.35);
}

/* 匹配结果 */
.match-card { margin-bottom: 40rpx; }
.match-title { font-size: 28rpx; font-weight: bold; color: #2a2825; margin-bottom: 14rpx; }
.match-empty { font-size: 24rpx; color: #999; text-align: center; padding: 30rpx 0; }
.match-item {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid #f5e0d4;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}
.match-icon {
  width: 76rpx; height: 76rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx;
  flex: none;
  margin-right: 16rpx;
}
.match-main { flex: 1; min-width: 0; }
.match-name { font-size: 27rpx; font-weight: bold; color: #2a2825; }
.match-cat { font-size: 20rpx; color: #bbb; font-weight: normal; margin-left: 8rpx; }
.match-bar { height: 10rpx; background: #f7ede5; border-radius: 999rpx; overflow: hidden; margin: 10rpx 0; }
.match-fill { height: 100%; background: linear-gradient(90deg, #ffd93d, #ff6b6b); border-radius: 999rpx; }
.match-own { font-size: 20rpx; color: #888; }
.match-missing { font-size: 20rpx; color: #b3591f; margin-top: 4rpx; }
.match-rate { flex: none; font-size: 30rpx; font-weight: 800; color: #ff6b6b; margin-left: 12rpx; }
