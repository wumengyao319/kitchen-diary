page {
  height: 100%;
  background-color: #f5f5f5;
}

.detail-scroll {
  height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.recipe-header {
  background-color: #ffffff;
}

.recipe-image {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recipe-emoji {
  font-size: 140rpx;
}

.recipe-info {
  padding: 32rpx;
}

.recipe-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.recipe-desc {
  font-size: 28rpx;
  color: #999999;
  display: block;
  margin-bottom: 24rpx;
}

.recipe-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
}

.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666666;
}

.section {
  background-color: #ffffff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.section-count {
  font-size: 26rpx;
  color: #999999;
}

.ingredients-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
}

.ingredient-name {
  font-size: 28rpx;
  color: #333333;
  margin-right: 12rpx;
}

.ingredient-amount {
  font-size: 26rpx;
  color: #999999;
}

.steps-list {
  padding-left: 12rpx;
}

.step-item {
  display: flex;
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.step-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.step-number {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.step-content {
  flex: 1;
}

.step-desc {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
}

.tips-box {
  background-color: #fff5f5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 16rpx 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  box-sizing: border-box;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
}

.bar-icon {
  font-size: 40rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
}

.bar-action {
  flex: 1;
  min-width: 180rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 18rpx 24rpx;
  border-radius: 40rpx;
  text-align: center;
  margin-left: 20rpx;
}

.action-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}