.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  padding: 40rpx 32rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999999;
}

.wheel-section {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wheel {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #ffd93d, #fdcb6e);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.wheel-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.wheel-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.spin-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spin-btn.spinning {
  opacity: 0.7;
}

.spin-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.result-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.result-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.result-emoji {
  font-size: 64rpx;
}

.result-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.result-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.result-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666666;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666666;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
}

.history-section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.clear-history {
  font-size: 24rpx;
  color: #999999;
}

.history-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.history-emoji {
  font-size: 28rpx;
}

.history-info {
  flex: 1;
}

.history-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 4rpx;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
}

.no-history {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.no-history-text {
  font-size: 26rpx;
  color: #999999;
}