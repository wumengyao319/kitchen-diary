.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 32rpx 24rpx;
  background-color: #ffffff;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.back-btn {
  font-size: 48rpx;
  color: #333;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 60rpx;
}

.list {
  height: calc(100vh - 140rpx - env(safe-area-inset-top));
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  margin-bottom: 12rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.info {
  flex: 1;
  margin-left: 24rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.action {
  margin-left: 24rpx;
}

.btn {
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid;
  line-height: 1.2;
}

.btn.unfollowed {
  background-color: #ffffff;
  color: #999;
  border-color: #e0e0e0;
}

.btn.followed {
  background-color: #ff6b6b;
  color: #ffffff;
  border-color: #ff6b6b;
}