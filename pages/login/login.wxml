<view class="container">
  <view class="logo-section">
    <view class="logo">🍳</view>
    <text class="app-name">美食食谱</text>
    <text class="app-desc">发现更多美味菜谱</text>
  </view>

  <view class="form-section" wx:if="{{!showRegister}}">
    <view class="form-group">
      <text class="input-icon">👤</text>
      <input class="input-field" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="form-group">
      <text class="input-icon">🔑</text>
      <input class="input-field" placeholder="请输入密码" type="password" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    
    <view class="form-options">
      <view class="checkbox" bindtap="toggleRemember">
        <view class="checkbox-box {{rememberMe ? 'checked' : ''}}">
          <text wx:if="{{rememberMe}}">✓</text>
        </view>
        <text class="checkbox-text">记住密码</text>
      </view>
    </view>

    <button class="login-btn" bindtap="login">登录</button>

    <view class="link-section">
      <text class="link-text" bindtap="showRegisterPage">还没有账号？立即注册</text>
    </view>
  </view>

  <view class="form-section" wx:else>
    <view class="form-header">
      <text class="form-title">注册账号</text>
      <text class="close-btn" bindtap="showLoginPage">✕</text>
    </view>
    
    <view class="form-group">
      <text class="input-icon">👤</text>
      <input class="input-field" placeholder="请输入账号" value="{{registerUsername}}" bindinput="onRegisterUsernameInput" />
    </view>
    <view class="form-group">
      <text class="input-icon">🔑</text>
      <input class="input-field" placeholder="请输入密码" type="password" value="{{registerPassword}}" bindinput="onRegisterPasswordInput" />
    </view>
    <view class="form-group">
      <text class="input-icon">🔑</text>
      <input class="input-field" placeholder="请确认密码" type="password" value="{{registerConfirmPassword}}" bindinput="onRegisterConfirmPasswordInput" />
    </view>
    <view class="form-group">
      <text class="input-icon">📧</text>
      <input class="input-field" placeholder="请输入昵称（选填）" value="{{registerNickname}}" bindinput="onRegisterNicknameInput" />
    </view>

    <button class="register-btn" bindtap="register">注册</button>
  </view>
</view>